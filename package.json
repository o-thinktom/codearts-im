{
  "name": "codearts-im",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "CodeArts IM Gateway workspace",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "layers": "node scripts/check-layers.mjs",
    "doctor": "node scripts/doctor.mjs",
    "demo": "tsx packages/qqbot-runtime/src/main.ts",
    "probe:qq": "tsx scripts/probe-qq.ts",
    "run:qq": "tsx scripts/run-qq.ts",
    "ipc:probe": "tsx scripts/ipc-probe.ts",
    "compat": "node scripts/compat-matrix.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "package:vsix": "node scripts/build-extension.mjs --vsix",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run layers && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "^1.109.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.3.0"
  }
}
